/* pages/admin/admin.ttss */

.container {
  padding: 30rpx;
  padding-bottom: 150rpx;
  min-height: calc(100vh - 100rpx);
}

/* 未登录提示界面 */
.login-required {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  text-align: center;
}

.login-required-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 40rpx;
}

.login-required-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.login-required-desc {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-bottom: 60rpx;
  line-height: 1.8;
}

.login-required .btn-primary {
  width: 400rpx;
}

/* 头部信息 */
.admin-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 价格列表 */
.price-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.price-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #ecf0f1;
  transition: background-color 0.2s;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item:active {
  background-color: #f8f9fa;
}

.price-item-left {
  flex: 1;
}

.price-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.price-item-unit {
  font-size: 24rpx;
  color: #7f8c8d;
}

.price-item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-item-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #3498db;
  min-width: 120rpx;
  text-align: right;
}

.price-item-action {
  font-size: 24rpx;
  color: #3498db;
  padding: 8rpx 20rpx;
  border: 2rpx solid #3498db;
  border-radius: 20rpx;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 30rpx;
}

/* 提示信息 */
.admin-tips {
  margin-top: 40rpx;
  padding: 30rpx;
  background-color: #fff9e6;
  border-radius: 12rpx;
  border-left: 4rpx solid #f39c12;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
  line-height: 2.2;
}

/* 按钮优化 */
.btn-danger {
  box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.3);
}

.btn-secondary {
  background-color: #ecf0f1;
  color: #34495e;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

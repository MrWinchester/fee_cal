/* pages/login/login.ttss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #7f8c8d;
}

/* 登录表单 */
.login-form {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #34495e;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.label-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfe6e9;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  font-size: 28rpx;
  color: #2c3e50;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #667eea;
  background-color: #ffffff;
}

.input-placeholder {
  color: #b2bec3;
}

/* 提示信息 */
.login-tips {
  text-align: center;
  padding-top: 30rpx;
  border-top: 1rpx solid #ecf0f1;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #95a5a6;
  line-height: 2;
}

/* 按钮优化 */
.btn-primary {
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.btn-secondary {
  background-color: #f8f9fa;
  color: #7f8c8d;
}

/* pages/calculator/calculator.ttss */

.container {
  padding: 30rpx;
  padding-bottom: 180rpx; /* 为底部导航栏留出空间 */
  min-height: calc(100vh - 100rpx);
  box-sizing: border-box;
}

/* 面积显示 */
.area-display {
  margin-top: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.area-label {
  font-size: 28rpx;
  color: #2e7d32;
  font-weight: 600;
  margin-right: 10rpx;
}

.area-value {
  font-size: 32rpx;
  color: #1b5e20;
  font-weight: 700;
}

/* 按面积计费的输入行 */
.input-row.area-based {
  background-color: #f1f8e9;
  border-radius: 8rpx;
  padding: 10rpx 0;
}

.auto-calculated {
  flex: 1;
  text-align: center;
  color: #558b2f;
  font-size: 24rpx;
  font-weight: 500;
}

/* 费用明细项 */
.fee-item {
  border-bottom: 1rpx solid #ecf0f1;
  padding: 20rpx 0;
}

.fee-item:last-child {
  border-bottom: none;
}

.fee-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fee-item-name {
  flex: 0 0 180rpx;
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.fee-item-detail {
  flex: 1;
  font-size: 24rpx;
  color: #7f8c8d;
  text-align: center;
}

.fee-item-price {
  flex: 0 0 150rpx;
  font-size: 28rpx;
  color: #e74c3c;
  font-weight: 600;
  text-align: right;
}

/* 总计卡片 */
.total-card {
  background: linear-gradient(135deg, #3498db, #2980b9);
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(52, 152, 219, 0.3);
  margin-bottom: 30rpx;
  margin-top: 20rpx;
}

.total-label {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
}

.total-amount {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 输入框优化 */
.input-field {
  text-align: center;
  color: #2c3e50;
  font-weight: 500;
}

.input-field:focus {
  border-color: #3498db;
}

/* 重置按钮样式优化 */
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn::after {
  border: none;
}

.btn-secondary {
  background-color: #ecf0f1;
  color: #34495e;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  color: #95a5a6;
  font-size: 28rpx;
  padding: 40rpx 0;
}
